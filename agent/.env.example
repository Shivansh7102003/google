# Required - CricketData.org
# Get your API key from https://cricketdata.org (free tier available)
CRICKET_API_KEY=your_cricketdata_org_api_key

# Required - Live Match ID
# Get from https://api.cricapi.com/v1/currentMatches?apikey=YOUR_KEY
# Look for a match where matchStarted=true and matchEnded=false
MATCH_ID=your_live_match_id

# Required - Gemini AI
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Required - Firebase Admin (for Phase 3)
# Project ID from Firebase Console → Project Settings
FIREBASE_PROJECT_ID=analysts-dugout

# Path to service account JSON (downloaded from Firebase Console → Project Settings → Service Accounts)
# In Docker, mount this as a volume: -v /path/to/key.json:/app/serviceAccountKey.json:ro
GOOGLE_APPLICATION_CREDENTIALS=/app/serviceAccountKey.json

# Optional - Agent Config
# Poll interval in milliseconds (default: 3000 = 3 seconds)
# POLL_INTERVAL_MS=3000

# Log level (default: info)
# LOG_LEVEL=info